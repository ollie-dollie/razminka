import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Введите первое число:");
        int a = sc.nextInt();
        System.out.println("Введите второе число:");
        int b = sc.nextInt();

        int result = multiplyRecursive(a, b);
        System.out.println("Результат умножения: " + result);
    }
    public static int multiplyRecursive(int a, int b) {
        int sign = ((a < 0) ^ (b < 0)) ? -1 : 1;

        long x = Math.abs((long) a);
        long y = Math.abs((long) b);

        long result = multiplyRecursiveHelper(x, y);
        return (int) (sign * result);
    }

    private static long multiplyRecursiveHelper(long a, long b) {
        if (b == 0) return 0;
        if (b == 1) return a;

        if ((b & 1) == 0) {
            return multiplyRecursiveHelper(a << 1, b >> 1);
        } else {
            return a + multiplyRecursiveHelper(a << 1, b >> 1);
        }
    }
}
