import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Введите первое число:");
        int a = sc.nextInt();

        System.out.println("Введите второе число:");
        int b = sc.nextInt();

        int result = multiplyUsingLogs(a, b);
        System.out.println("Результат умножения: " + result);

    }
    public static int multiplyUsingLogs(int a, int b) {
        if (a == 0 || b == 0) return 0;

        int sign = ((a < 0) ^ (b < 0)) ? -1 : 1;

        double x = Math.abs((double) a);
        double y = Math.abs((double) b);

        double result = Math.exp(Math.log(x) + Math.log(y));

        return (int) (sign * Math.round(result));
    }
}
